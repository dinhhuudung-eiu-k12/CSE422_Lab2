@model DeviceManagement.Models.Employee
@{
    ViewData["Title"] = $"Delete Employee - {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 border-top border-danger border-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-person-x-fill me-2"></i>Delete Employee Confirmation
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-3 me-3 text-warning flex-shrink-0"></i>
                    <div>
                        <strong>Are you sure?</strong> This will remove <strong>@Model.FullName</strong> from the staff directory.
                    </div>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Full Name:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Email Address:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted">Phone Number:</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i> Confirm &amp; Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
