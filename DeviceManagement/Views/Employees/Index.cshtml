@model IEnumerable<DeviceManagement.Models.Employee>
@{
    ViewData["Title"] = "Employees & Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-people text-primary me-2"></i>Employees &amp; Device Users
        </h1>
        <p class="text-muted mb-0">Manage employee contact directory for hardware users across departments.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Add Employee
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 35%;">Full Name</th>
                        <th style="width: 35%;">Email Address</th>
                        <th style="width: 20%;">Phone Number</th>
                        <th class="text-end pe-3" style="width: 10%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2"></i>
                                <h5>No employee records found</h5>
                                <p class="mb-2">Add the first employee contact to the organizational directory.</p>
                                <a asp-action="Create" class="btn btn-sm btn-primary">Add Employee</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                        <i class="bi bi-person-circle text-secondary me-2"></i>@item.FullName
                                    </a>
                                </td>
                                <td>
                                    <a href="mailto:@item.Email" class="text-decoration-none">
                                        <i class="bi bi-envelope me-1 text-muted"></i>@item.Email
                                    </a>
                                </td>
                                <td class="text-muted">
                                    <i class="bi bi-telephone me-1 text-muted"></i>@item.PhoneNumber
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Any())
    {
        <div class="card-footer bg-white border-top py-2 px-3 text-muted small">
            Total active employees: @Model.Count()
        </div>
    }
</div>
