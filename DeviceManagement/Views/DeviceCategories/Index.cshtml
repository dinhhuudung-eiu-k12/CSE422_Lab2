@model IEnumerable<DeviceManagement.Models.DeviceCategory>
@{
    ViewData["Title"] = "Device Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-tags text-primary me-2"></i>Device Categories
        </h1>
        <p class="text-muted mb-0">Manage hardware asset classification groups.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 25%;">Category Name</th>
                        <th style="width: 45%;">Description</th>
                        <th style="width: 15%;">Assigned Devices</th>
                        <th class="text-end pe-3" style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-tag fs-1 d-block mb-2"></i>
                                <h5>No categories found</h5>
                                <p class="mb-2">Get started by creating your first device category.</p>
                                <a asp-action="Create" class="btn btn-sm btn-primary">Create Category</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                        @item.Name
                                    </a>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </td>
                                <td>
                                    <a asp-controller="Devices" asp-action="Index" asp-route-categoryId="@item.Id" 
                                       class="badge bg-primary-subtle text-primary text-decoration-none px-2 py-1 fs-6" 
                                       title="View all devices in this category">
                                        <i class="bi bi-laptop me-1"></i>@item.Devices.Count device@(item.Devices.Count == 1 ? "" : "s")
                                    </a>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
