@model DeviceManagement.Models.DeviceCategory
@{
    ViewData["Title"] = $"Category Details - {Model.Name}";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-tag-fill text-primary me-2"></i>Category Information
                </h5>
            </div>
            <div class="card-body p-4">
                <span class="text-muted small text-uppercase fw-semibold">Category Name</span>
                <h4 class="fw-bold text-dark mt-1">@Model.Name</h4>

                <span class="text-muted small text-uppercase fw-semibold d-block mt-3">Description</span>
                <p class="text-dark mt-1">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </p>

                <span class="text-muted small text-uppercase fw-semibold d-block mt-3">Total Hardware Assets</span>
                <span class="badge bg-primary fs-6 mt-1">@Model.Devices.Count device@(Model.Devices.Count == 1 ? "" : "s")</span>

                <hr class="my-4" />

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Edit Category
                    </a>
                    <a asp-controller="Devices" asp-action="Create" asp-route-categoryId="@Model.Id" class="btn btn-outline-success">
                        <i class="bi bi-plus-circle me-1"></i> Add Device to this Category
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete Category
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Categories
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Devices in this Category Table (REQ-DEV-06) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-laptop me-2 text-primary"></i>Devices in @Model.Name
                </h5>
                <a asp-controller="Devices" asp-action="Index" asp-route-categoryId="@Model.Id" class="btn btn-sm btn-outline-primary">
                    View in Device Inventory
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Device Name</th>
                                <th>Code</th>
                                <th>Status</th>
                                <th>Entry Date</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Devices.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No devices are currently assigned to this category.
                                        <div class="mt-2">
                                            <a asp-controller="Devices" asp-action="Create" asp-route-categoryId="@Model.Id" class="btn btn-sm btn-primary">
                                                Add First Device
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var device in Model.Devices)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">
                                            <a asp-controller="Devices" asp-action="Details" asp-route-id="@device.Id" class="text-decoration-none text-dark">
                                                @device.Name
                                            </a>
                                        </td>
                                        <td><code>@device.DeviceCode</code></td>
                                        <td>
                                            @if (device.Status == DeviceStatus.InUse)
                                            {
                                                <span class="badge bg-success">In Use</span>
                                            }
                                            else if (device.Status == DeviceStatus.UnderMaintenance)
                                            {
                                                <span class="badge bg-warning text-dark">Under Maintenance</span>
                                            }
                                            else if (device.Status == DeviceStatus.Broken)
                                            {
                                                <span class="badge bg-danger">Broken</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@device.DateOfEntry.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Devices" asp-action="Details" asp-route-id="@device.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
