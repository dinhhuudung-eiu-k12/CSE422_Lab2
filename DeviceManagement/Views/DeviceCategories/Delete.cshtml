@model DeviceManagement.Models.DeviceCategory
@{
    ViewData["Title"] = $"Delete Category - {Model.Name}";
    bool hasDevices = ViewBag.HasReferencingDevices == true;
    int deviceCount = ViewBag.DeviceCount ?? 0;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 border-top border-danger border-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Category Confirmation
                </h4>
            </div>
            <div class="card-body p-4">
                @if (hasDevices)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-shield-slash-fill fs-3 me-3 text-danger flex-shrink-0"></i>
                        <div>
                            <h5 class="alert-heading fw-bold mb-1">Deletion Blocked</h5>
                            <p class="mb-0">
                                This category cannot be deleted because it currently contains <strong>@deviceCount</strong> hardware device(s). 
                                To maintain data integrity, please delete or reassign all referenced devices before deleting this category.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-circle-fill fs-3 me-3 text-warning flex-shrink-0"></i>
                        <div>
                            <strong>Are you sure?</strong> Category "<strong>@Model.Name</strong>" will be permanently removed.
                        </div>
                    </div>
                }

                <div class="bg-light p-3 rounded-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Category Name:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-4 text-muted">Description:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                        <dt class="col-sm-4 text-muted">Referenced Devices:</dt>
                        <dd class="col-sm-8">
                            @if (hasDevices)
                            {
                                <span class="badge bg-danger">@deviceCount device(s) attached</span>
                            }
                            else
                            {
                                <span class="badge bg-success">0 devices (Safe to delete)</span>
                            }
                        </dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Categories
                        </a>
                        <div class="d-flex gap-2">
                            @if (hasDevices)
                            {
                                <a asp-controller="Devices" asp-action="Index" asp-route-categoryId="@Model.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-laptop me-1"></i> View Referenced Devices
                                </a>
                                <button type="button" class="btn btn-danger px-4" disabled title="Cannot delete category with referenced devices">
                                    <i class="bi bi-lock-fill me-1"></i> Deletion Blocked
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="bi bi-trash-fill me-1"></i> Confirm &amp; Delete
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
