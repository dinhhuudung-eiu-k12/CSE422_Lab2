@model DeviceManagement.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Device Inventory Dashboard
        </h1>
        <p class="text-muted mb-0">Overview of hardware assets, operational statuses, categories, and staff directory.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Devices" asp-action="Create" class="btn btn-primary me-1 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Device
        </a>
        <a asp-controller="DeviceCategories" asp-action="Create" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-tag me-1"></i> New Category
        </a>
    </div>
</div>

<!-- Metrics Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-primary border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Total Devices</span>
                    <h2 class="fw-bold text-dark mt-1 mb-0">@Model.TotalDevices</h2>
                    <a asp-controller="Devices" asp-action="Index" class="small text-decoration-none mt-2 d-inline-block">View all devices &rarr;</a>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-laptop fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-info border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Categories</span>
                    <h2 class="fw-bold text-dark mt-1 mb-0">@Model.TotalCategories</h2>
                    <a asp-controller="DeviceCategories" asp-action="Index" class="small text-decoration-none mt-2 d-inline-block">Manage categories &rarr;</a>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-tags fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-secondary border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Employees / Users</span>
                    <h2 class="fw-bold text-dark mt-1 mb-0">@Model.TotalEmployees</h2>
                    <a asp-controller="Employees" asp-action="Index" class="small text-decoration-none mt-2 d-inline-block">View staff list &rarr;</a>
                </div>
                <div class="bg-secondary bg-opacity-10 text-secondary p-3 rounded-circle">
                    <i class="bi bi-people fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Breakdown Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-success border-4">
            <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-success fw-bold text-uppercase small">In Use</span>
                    <h3 class="fw-bold mb-0">@Model.InUseCount</h3>
                    <a asp-controller="Devices" asp-action="Index" asp-route-status="1" class="small text-success text-decoration-none">Filter In Use &rarr;</a>
                </div>
                <span class="badge bg-success-subtle text-success p-2 rounded-circle fs-5"><i class="bi bi-check-circle"></i></span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-warning border-4">
            <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-warning-emphasis fw-bold text-uppercase small">Under Maintenance</span>
                    <h3 class="fw-bold mb-0">@Model.UnderMaintenanceCount</h3>
                    <a asp-controller="Devices" asp-action="Index" asp-route-status="3" class="small text-warning-emphasis text-decoration-none">Filter Maintenance &rarr;</a>
                </div>
                <span class="badge bg-warning-subtle text-warning-emphasis p-2 rounded-circle fs-5"><i class="bi bi-wrench"></i></span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-danger border-4">
            <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-danger fw-bold text-uppercase small">Broken</span>
                    <h3 class="fw-bold mb-0">@Model.BrokenCount</h3>
                    <a asp-controller="Devices" asp-action="Index" asp-route-status="2" class="small text-danger text-decoration-none">Filter Broken &rarr;</a>
                </div>
                <span class="badge bg-danger-subtle text-danger p-2 rounded-circle fs-5"><i class="bi bi-x-octagon"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Devices Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Device Registrations</h5>
                <a asp-controller="Devices" asp-action="Index" class="btn btn-sm btn-outline-primary">View Full Inventory</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Device Name</th>
                                <th>Code</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Entry Date</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentDevices.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No devices registered yet. <a asp-controller="Devices" asp-action="Create">Register the first device</a>.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var device in Model.RecentDevices)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@device.Name</td>
                                        <td><code>@device.DeviceCode</code></td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                                @(device.DeviceCategory?.Name ?? "Unassigned")
                                            </span>
                                        </td>
                                        <td>
                                            @if (device.Status == DeviceStatus.InUse)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>In Use</span>
                                            }
                                            else if (device.Status == DeviceStatus.UnderMaintenance)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-wrench me-1"></i>Under Maintenance</span>
                                            }
                                            else if (device.Status == DeviceStatus.Broken)
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Broken</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@device.DateOfEntry.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Devices" asp-action="Details" asp-route-id="@device.Id" class="btn btn-sm btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Distribution Breakdown -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart me-2 text-info"></i>Devices by Category</h5>
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.CategoryCounts.Any())
                {
                    <div class="list-group-item text-center text-muted py-3">No categories defined yet.</div>
                }
                else
                {
                    @foreach (var cat in Model.CategoryCounts)
                    {
                        <a asp-controller="Devices" asp-action="Index" asp-route-categoryId="@cat.CategoryId" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span class="fw-medium">@cat.CategoryName</span>
                            <span class="badge bg-primary rounded-pill">@cat.DeviceCount</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>
