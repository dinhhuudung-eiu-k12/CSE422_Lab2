@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-shield-check text-primary me-2"></i>Privacy &amp; Data Governance Policy
                </h4>
            </div>
            <div class="card-body p-4 text-secondary">
                <p>
                    This application is developed as part of <strong>CSE 422 - .NET Programming Practice Assignment 2</strong>.
                </p>
                <h5 class="fw-bold text-dark mt-4">1. Data Collected</h5>
                <p>
                    The system stores hardware asset records (device names, serial codes, operational statuses, entry dates) and user directory contacts (full name, email, phone number) for internal inventory management.
                </p>
                <h5 class="fw-bold text-dark mt-4">2. Security &amp; Protection</h5>
                <p>
                    All form submissions are secured with ASP.NET Core anti-forgery tokens (CSRF protection). Database queries are executed through Entity Framework Core parameterized commands to prevent SQL injection vulnerabilities.
                </p>
            </div>
        </div>
    </div>
</div>
