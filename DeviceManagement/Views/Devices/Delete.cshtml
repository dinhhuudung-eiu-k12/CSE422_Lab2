@model DeviceManagement.Models.Device
@{
    ViewData["Title"] = $"Delete Device - {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 border-top border-danger border-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Device Confirmation
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-4 me-3 text-warning"></i>
                    <div>
                        <strong>Warning:</strong> Are you sure you want to permanently delete this device? This action cannot be undone.
                    </div>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Device Name:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-4 text-muted">Device Code:</dt>
                        <dd class="col-sm-8"><code>@Model.DeviceCode</code></dd>

                        <dt class="col-sm-4 text-muted">Category:</dt>
                        <dd class="col-sm-8">@(Model.DeviceCategory?.Name ?? "Unassigned")</dd>

                        <dt class="col-sm-4 text-muted">Operational Status:</dt>
                        <dd class="col-sm-8">@Model.Status</dd>

                        <dt class="col-sm-4 text-muted">Date of Entry:</dt>
                        <dd class="col-sm-8">@Model.DateOfEntry.ToString("yyyy-MM-dd")</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i> Confirm &amp; Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
