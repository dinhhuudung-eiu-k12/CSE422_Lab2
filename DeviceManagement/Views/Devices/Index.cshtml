@model DeviceManagement.ViewModels.DeviceIndexViewModel
@{
    ViewData["Title"] = "Device Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-laptop text-primary me-2"></i>Device Inventory
        </h1>
        <p class="text-muted mb-0">Manage hardware devices, codes, operational statuses, and categories.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Register New Device
        </a>
    </div>
</div>

<!-- Search and Filter Panel -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <!-- Search Text (Name or Code) -->
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@Model.SearchString" 
                           class="form-control border-start-0" placeholder="Search by name or device code..." />
                </div>
            </div>

            <!-- Filter by Category -->
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">-- All Categories --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Value" selected="@(cat.Selected)">@cat.Text</option>
                    }
                </select>
            </div>

            <!-- Filter by Status -->
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    @foreach (var st in Model.Statuses)
                    {
                        <option value="@st.Value" selected="@(st.Selected)">@st.Text</option>
                    }
                </select>
            </div>

            <!-- Submit & Reset Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset all filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Filter Status Banner (Active Filters) -->
@if (Model.HasActiveFilters)
{
    <div class="alert alert-light border d-flex justify-content-between align-items-center py-2 mb-3">
        <div>
            <i class="bi bi-info-circle text-primary me-2"></i>
            <span>Showing filtered results (<strong>@Model.TotalCount</strong> device@(Model.TotalCount == 1 ? "" : "s") found).</span>
            @if (!string.IsNullOrWhiteSpace(Model.SearchString))
            {
                <span class="badge bg-secondary ms-1">Keyword: "@Model.SearchString"</span>
            }
            @if (Model.Status.HasValue)
            {
                <span class="badge bg-info text-dark ms-1">Status: @Model.Status.Value</span>
            }
            @if (Model.CategoryId.HasValue && Model.CategoryId.Value > 0)
            {
                var catName = Model.Categories.FirstOrDefault(c => c.Value == Model.CategoryId.Value.ToString())?.Text;
                <span class="badge bg-primary ms-1">Category: @catName</span>
            }
        </div>
        <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-danger p-0">Clear all filters</a>
    </div>
}

<!-- Devices Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Device Name</th>
                        <th>Device Code</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Date of Entry</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Devices.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <h5>No devices found</h5>
                                    @if (Model.HasActiveFilters)
                                    {
                                        <p class="mb-2">No hardware matches your active search and filter criteria.</p>
                                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
                                    }
                                    else
                                    {
                                        <p class="mb-2">The device inventory is currently empty.</p>
                                        <a asp-action="Create" class="btn btn-sm btn-primary">Add First Device</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Devices)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark fw-bold">
                                        @item.Name
                                    </a>
                                </td>
                                <td>
                                    <code class="px-2 py-1 bg-light border rounded">@item.DeviceCode</code>
                                </td>
                                <td>
                                    <a asp-controller="Devices" asp-action="Index" asp-route-categoryId="@item.DeviceCategoryId" 
                                       class="badge bg-secondary-subtle text-secondary-emphasis text-decoration-none" title="Filter by this category">
                                        @(item.DeviceCategory?.Name ?? "Unassigned")
                                    </a>
                                </td>
                                <td>
                                    @if (item.Status == DeviceStatus.InUse)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>In Use</span>
                                    }
                                    else if (item.Status == DeviceStatus.UnderMaintenance)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-wrench me-1"></i>Under Maintenance</span>
                                    }
                                    else if (item.Status == DeviceStatus.Broken)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Broken</span>
                                    }
                                </td>
                                <td class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@item.DateOfEntry.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Devices.Any())
    {
        <div class="card-footer bg-white border-top py-2 px-3 d-flex justify-content-between align-items-center text-muted small">
            <span>Showing @Model.Devices.Count() device record@(Model.Devices.Count() == 1 ? "" : "s")</span>
            <span>Total inventory: @Model.TotalCount</span>
        </div>
    }
</div>
