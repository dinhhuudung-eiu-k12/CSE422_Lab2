@model DeviceManagement.Models.Device
@{
    ViewData["Title"] = $"Device Details - {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i>Hardware Device Information
                </h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Inventory
                </a>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-7">
                        <span class="text-muted small text-uppercase fw-semibold">Device Name</span>
                        <h3 class="fw-bold text-dark mt-1">@Model.Name</h3>
                    </div>
                    <div class="col-md-5">
                        <span class="text-muted small text-uppercase fw-semibold">Device Code</span>
                        <h4 class="mt-1"><code class="px-2 py-1 bg-light border rounded">@Model.DeviceCode</code></h4>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted small text-uppercase fw-semibold">Category</span>
                        <div class="mt-1">
                            @if (Model.DeviceCategory != null)
                            {
                                <a asp-action="Index" asp-route-categoryId="@Model.DeviceCategoryId" class="badge bg-secondary-subtle text-secondary-emphasis fs-6 text-decoration-none">
                                    <i class="bi bi-tag me-1"></i>@Model.DeviceCategory.Name
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">Unassigned</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted small text-uppercase fw-semibold">Operational Status</span>
                        <div class="mt-1">
                            @if (Model.Status == DeviceStatus.InUse)
                            {
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>In Use</span>
                            }
                            else if (Model.Status == DeviceStatus.UnderMaintenance)
                            {
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-wrench me-1"></i>Under Maintenance</span>
                            }
                            else if (Model.Status == DeviceStatus.Broken)
                            {
                                <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Broken</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted small text-uppercase fw-semibold">Date of Entry</span>
                        <div class="mt-1 text-dark fw-medium">
                            <i class="bi bi-calendar-event me-1 text-primary"></i>
                            @Model.DateOfEntry.ToString("MMMM dd, yyyy")
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete Device
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Inventory</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                            <i class="bi bi-pencil me-1"></i> Edit Device
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
