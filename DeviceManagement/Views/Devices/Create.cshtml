@model DeviceManagement.Models.Device
@{
    ViewData["Title"] = "Register New Device";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Register New Hardware Device
                </h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Inventory
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <!-- Device Name -->
                        <div class="col-md-7">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Dell Latitude 5540 15&quot;" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Device Code -->
                        <div class="col-md-5">
                            <label asp-for="DeviceCode" class="form-label fw-semibold"></label>
                            <input asp-for="DeviceCode" class="form-control text-uppercase" placeholder="e.g. DEV-LT-005" />
                            <span asp-validation-for="DeviceCode" class="text-danger small"></span>
                            <div class="form-text small">Unique asset tracking code.</div>
                        </div>

                        <!-- Device Category -->
                        <div class="col-md-6">
                            <label asp-for="DeviceCategoryId" class="form-label fw-semibold">Device Category</label>
                            <select asp-for="DeviceCategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="DeviceCategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Operational Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<DeviceStatus>()">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <!-- Date of Entry -->
                        <div class="col-md-6">
                            <label asp-for="DateOfEntry" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfEntry" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateOfEntry" class="text-danger small"></span>
                            <div class="form-text small">Entry date cannot be in the future.</div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Register Device
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
